# Environment variables for Shiva Bharti Portfolio Website

# Database connection URL (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example Supabase/Neon/Local: postgresql://postgres:postgres@localhost:5432/portfolio_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db?schema=public"

# Authentication secret for JWT / Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="shiva_bharti_secure_portfolio_auth_secret_key_2026_super_safe"
AUTH_URL="http://localhost:3000"

# Initial admin credentials for seeding
ADMIN_EMAIL="shivaharti9080@gmail.com"
ADMIN_PASSWORD="AdminSecurePassword2026!"
ADMIN_NAME="Shiva Bharti"

# GitHub REST API Token (Optional, for higher rate limits)
GITHUB_TOKEN=""
NEXT_PUBLIC_GITHUB_USERNAME="shivabharti9080"

# Resend Email Configuration (Optional - for sending contact notifications)
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="onboarding@resend.dev"
CONTACT_TO_EMAIL="shivaharti9080@gmail.com"

# Object Storage Configuration (Optional - local filesystem upload is supported by default)
